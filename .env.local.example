# Copy this file to .env.local and fill in your Supabase project values.
# From the Supabase dashboard: Settings → API.

# Server-only credentials. Never prefix the service role key with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only Gemini credentials for AI poll draft generation.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
